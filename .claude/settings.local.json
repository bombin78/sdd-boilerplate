{
  "env": {
    "npm_config_update_notifier": "false"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/notes/hooks/protect-notes.sh"
          },
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR\"/notes/hooks/block-git-writes.py"
          }
        ]
      }
    ]
  }
} 
