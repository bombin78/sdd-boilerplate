{
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.bashrc)",
      "Read(~/.profile)",
      "Read(~/.bash_history)",
      "Read(~/.git-credentials)",
      "Read(~/.npmrc)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gh/**)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git restore *)",
      "Bash(git reset *)",
      "Bash(git push *)",
      "Edit(.git/**)"
    ],
    "allow": [
      "Read(.)",
      "Read(./**)",
      "Write(.)",
      "Write(./**)",
      "Edit(.)",
      "Edit(./**)",
      "WebSearch",
      "WebFetch"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowRead": [
        "."
      ],
      "allowWrite": [
        "."
      ],
      "denyRead": [
        "~/"
      ],
      "denyWrite": [
        ".git"
      ]
    }
  }
}
